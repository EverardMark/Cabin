<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Host theme applied before Compose takes over. Compose draws the Cabin
         Soft UI edge to edge, so this only needs a matching window ground and
         dark status-bar icons. -->
    <style name="Theme.Cabin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
