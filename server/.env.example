# Copy to .env and adjust. All values have sensible dev defaults.

# HTTP port the API listens on
PORT=8080

# Directory where uploaded listing images are stored
UPLOAD_DIR=uploads

# Secret used to sign JWTs. REQUIRED in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# development | production
ENV=development

# Seed demo data (a demo account + sample listings) when the DB is empty.
# Defaults to true in development, false in production.
SEED=true

# Sign in with Apple: comma-separated accepted audiences — the iOS bundle ID,
# plus a Services ID if web/Android sign-in is added. Empty disables it.
APPLE_CLIENT_ID=com.ueline.Cabin.demo

# --- Database -------------------------------------------------------------
# DB_DRIVER selects the backend: "sqlite" (default, zero setup) or "mysql".
DB_DRIVER=sqlite

# SQLite (when DB_DRIVER=sqlite): path to the database file (created automatically)
DB_PATH=cabin.db

# MySQL (when DB_DRIVER=mysql). Either provide a full DSN...
# MYSQL_DSN=cabin:secret@tcp(127.0.0.1:3306)/cabin?parseTime=true&charset=utf8mb4&loc=UTC
# ...or the individual parts (a DSN is built from these):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cabin
MYSQL_PASSWORD=
MYSQL_DATABASE=cabin
